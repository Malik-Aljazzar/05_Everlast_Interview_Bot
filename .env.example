# Kopieren nach .env und ausfüllen. .env wird nicht committet.

# Header-Secret für den n8n-Webhook (n8n Header Auth Credential + Vapi Custom Credential, Header: X-Vapi-Secret)
WEBHOOK_SECRET=

# Vapi Private API Key (Dashboard > API Keys)
VAPI_API_KEY=

# Werden von vapi/deploy.py beim ersten Lauf ergänzt
VAPI_CREDENTIAL_ID=
VAPI_ASSISTANT_ID=
