      {
        "id": "6e3693ca-d242-4dfe-a085-52d21ea192db",
        "name": "Prompt aktualisieren",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1220,
          300
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "// Ersetzt im Vapi-System-Prompt die Abschnitte \"# Stelle\" und \"# Leitfaden\".\nconst a = $('Prompt-Abschnitte bauen').item.json;\nconst model = $json.model ?? {};\nconst messages = model.messages ?? [];\nconst index = messages.findIndex((m) => m.role === 'system');\nif (index < 0) throw new Error('Kein System-Prompt im Assistant ' + a.assistantId + '.');\n\nconst ersetzen = (text, start, ende, inhalt) => {\n  const re = new RegExp('(' + start + '\\\\n)([\\\\s\\\\S]*?)(\\\\n' + ende + '\\\\n)');\n  if (!re.test(text)) throw new Error('Abschnitt \"' + start + '\" fehlt im Vapi-Prompt von ' + a.assistantId + '.');\n  return text.replace(re, (m, kopf, alt, fuss) => kopf + '\\n' + inhalt + '\\n' + fuss);\n};\n\nconst alt = messages[index].content ?? '';\nlet neu = ersetzen(alt, '# Stelle', '# Leitfaden', a.abschnittStelle);\nneu = ersetzen(neu, '# Leitfaden', '# Gesprächsregeln', a.abschnittLeitfaden);\n\nconst neueMessages = messages.map((m, i) => (i === index ? { ...m, content: neu } : m));\nreturn { json: {\n  assistantId: a.assistantId,\n  name: $json.name,\n  geaendert: neu !== alt,\n  model: { ...model, messages: neueMessages },\n} };"
        }
      },
