    "name": "Vapi – Leitfaden synchronisieren",
    "description": "Übernimmt Stellenfakten und Interview-Leitfaden aus den n8n Data Tables in den System-Prompt der Vapi-Assistants. Wird nach jedem Speichern in der UI aufgerufen und schreibt nur bei Änderungen; manuell startbar.",
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "id": "19dd5997-a7a5-478c-8b8a-fe47836c482b",
        "name": "Jetzt synchronisieren",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [
          0,
          200
        ],
        "parameters": {}
      },
      {
        "id": "a4f5d1d1-706f-4a9d-8c31-c729397afbbc",
        "name": "Prompt-Abschnitte bauen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          740,
          300
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Baut je Stelle (Assistant-ID) aus den Data Tables die Prompt-Abschnitte \"Stelle\" und \"Leitfaden\" für Vapi.\nconst liste = (text) => String(text ?? '').split(/\\n|;/).map((s) => s.trim()).filter(Boolean);\nconst unterpunkte = (text) => liste(text).map((x) => '  - ' + x);\n\nconst nachPosition = (a, b) => (Number(a.position) || 0) - (Number(b.position) || 0);\nconst leitfaden = $('Leitfaden lesen').all().map((i) => i.json).filter((r) => r.assistantId && r.frage);\nconst stellen = $('Stellen lesen').all().map((i) => i.json).filter((r) => r.assistantId);\n\nreturn stellen.map((s) => {\n  const id = String(s.assistantId).trim();\n  // Reihenfolge = Spalte position (in der UI per Drag & Drop bzw. Pfeilen festgelegt).\n  const fragen = leitfaden.filter((l) => String(l.assistantId).trim() === id).sort(nachPosition);\n\n  const abschnittStelle = [\n    'Nur diese Fakten darfst du nennen:',\n    '',\n    '- Stelle: ' + s.stelle,\n    '- Unternehmen: ' + (s.unternehmen ?? ''),\n    '- Aufgaben und Anforderungen:',\n    ...unterpunkte(s.beschreibung),\n    '',\n    'Alles andere weißt du nicht, zum Beispiel Gehalt der Stelle, Benefits, Homeoffice oder Remote, Arbeitszeiten, Team, Kunden, Ablauf und Dauer des Bewerbungsprozesses. Erfinde dazu nichts. Sag ehrlich, dass du das nicht weißt und das HR-Team die Frage beantwortet.',\n  ].join('\\n');\n\n  const schritte = fragen.map((f, i) =>\n    (i + 1) + '. ' + f.thema + ': „' + String(f.frage).trim() + '“' + (String(f.hinweis ?? '').trim() ? ' ' + String(f.hinweis).trim() : '')\n  );\n  schritte.push((fragen.length + 1) + '. Abschluss: siehe unten.');\n  const abschnittLeitfaden = [\n    'Arbeite die Punkte in dieser Reihenfolge ab. Stell die Fragen sinngemäß so wie hier, damit alle Bewerber dieselben Kernfragen bekommen.',\n    '',\n    ...schritte,\n  ].join('\\n');\n\n  return { json: { assistantId: id, stelle: s.stelle, anzahlFragen: fragen.length, abschnittStelle, abschnittLeitfaden } };\n});"
        }
      },
      {
        "id": "f9e9a7ee-00ce-4721-89fe-647b10578558",
        "name": "Assistant laden",
        "type": "n8n-nodes-base.httpRequest",
