        ],
        "parameters": {
          "method": "GET",
          "url": "=https://api.vapi.ai/assistant/{{ $json.assistantId }}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendHeaders": true,
          "specifyHeaders": "keypair",
          "headerParameters": {
            "parameters": [
              {
                "name": "User-Agent",
                "value": "everlast-n8n-sync/1.0"
              }
            ]
          },
          "options": {}
        },
        "credentials": {
          "httpHeaderAuth": {
            "id": "rEWuAIoBRZRraSyN",
