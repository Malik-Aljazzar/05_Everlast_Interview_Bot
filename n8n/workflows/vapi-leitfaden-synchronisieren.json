      {
        "id": "a4f5d1d1-706f-4a9d-8c31-c729397afbbc",
        "name": "Prompt-Abschnitte bauen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          740,
          300
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Baut je Stelle (Assistant-ID) die Prompt-Abschnitte \"Stelle\" und \"Leitfaden\" für Vapi.\nconst liste = (text) => String(text ?? '').split(/\\n|;/).map((s) => s.trim()).filter(Boolean);\nconst unterpunkte = (text) => liste(text).map((x) => '  - ' + x);\nconst zahl = (v) => parseFloat(String(v ?? '').replace(',', '.'));\n\nconst leitfaden = $('Leitfaden lesen').all().map((i) => i.json).filter((r) => r['Assistant-ID'] && r.Frage);\nconst stellen = $('Stellen lesen').all().map((i) => i.json).filter((r) => r['Assistant-ID']);\n\nreturn stellen.map((s) => {\n  const id = String(s['Assistant-ID']).trim();\n  const fragen = leitfaden\n    .filter((l) => String(l['Assistant-ID']).trim() === id)\n    .sort((a, b) => zahl(a.Nr) - zahl(b.Nr));\n\n  const abschnittStelle = [\n    'Nur diese Fakten darfst du nennen:',\n    '',\n    '- Stelle: ' + s.Stelle,\n    '- Unternehmen: ' + (s.Unternehmen ?? ''),\n    '- Aufgaben:',\n    ...unterpunkte(s.Aufgaben),\n    '- Anforderungen:',\n    ...unterpunkte(s.Anforderungen),\n    '',\n    'Alles andere weißt du nicht, zum Beispiel Gehalt der Stelle, Benefits, Homeoffice oder Remote, Arbeitszeiten, Team, Kunden, Ablauf und Dauer des Bewerbungsprozesses. Erfinde dazu nichts. Sag ehrlich, dass du das nicht weißt und das HR-Team die Frage beantwortet.',\n  ].join('\\n');\n\n  const schritte = fragen.map((f, i) =>\n    (i + 1) + '. ' + f.Thema + ': „' + String(f.Frage).trim() + '“' + (String(f.Hinweis ?? '').trim() ? ' ' + String(f.Hinweis).trim() : '')\n  );\n  schritte.push((fragen.length + 1) + '. Abschluss: siehe unten.');\n  const abschnittLeitfaden = [\n    'Arbeite die Punkte in dieser Reihenfolge ab. Stell die Fragen sinngemäß so wie hier, damit alle Bewerber dieselben Kernfragen bekommen.',\n    '',\n    ...schritte,\n  ].join('\\n');\n\n  return { json: { assistantId: id, stelle: s.Stelle, anzahlFragen: fragen.length, abschnittStelle, abschnittLeitfaden } };\n});"
        }
      },
      {
        "id": "f9e9a7ee-00ce-4721-89fe-647b10578558",
        "name": "Assistant laden",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          980,
