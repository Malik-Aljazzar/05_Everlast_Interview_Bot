      {
        "id": "d392236c-a0e0-4308-8604-26a232110297",
        "name": "Eingabe prüfen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          544
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Prüft die Konfiguration einer Stelle aus der UI und bringt sie in die Form der Data Tables.\nconst b = $input.first().json.body ?? {};\nconst text = (v) => String(v ?? '').trim();\nconst zahl = (v) => {\n  if (v === '' || v === null || v === undefined) return null;\n  const n = Number(String(v).replace(',', '.'));\n  return Number.isFinite(n) ? n : null;\n};\nconst fehler = (meldung) => [{ json: { ok: false, fehler: meldung } }];\n\nconst id = text(b.assistantId);\nif (!id) return fehler('Assistant-ID fehlt.');\nconst s = b.stelle ?? {};\nif (!text(s.stelle)) return fehler('Die Bezeichnung der Stelle fehlt.');\n\nconst kriterien = (Array.isArray(b.kriterien) ? b.kriterien : []).filter((k) => text(k.kriterium)).map((k, i) => ({\n  assistantId: id,\n  position: i + 1,\n  kriterium: text(k.kriterium),\n  gewicht: zahl(k.gewicht),\n  beschreibung: text(k.beschreibung),\n  score1: text(k.score1),\n  score2: text(k.score2),\n  score3: text(k.score3),\n  score4: text(k.score4),\n  score5: text(k.score5),\n}));\n// Kriterium im Leitfaden immer in der Schreibweise des Kriteriums speichern.\nconst kanon = new Map(kriterien.map((k) => [k.kriterium.toLowerCase(), k.kriterium]));\nconst leitfaden = (Array.isArray(b.leitfaden) ? b.leitfaden : []).filter((l) => text(l.frage)).map((l, i) => ({\n  assistantId: id,\n  position: i + 1,\n  thema: text(l.thema) || 'Frage ' + (i + 1),\n  frage: text(l.frage),\n  kriterium: kanon.get(text(l.kriterium).toLowerCase()) ?? text(l.kriterium),\n  hinweis: text(l.hinweis),\n}));\nif (!kriterien.length) return fehler('Mindestens ein Bewertungskriterium ist nötig.');\nif (!leitfaden.length) return fehler('Der Leitfaden braucht mindestens eine Frage.');\n\nif (kanon.size !== kriterien.length) return fehler('Jedes Kriterium braucht einen eigenen Namen.');\nconst unbekannt = leitfaden.filter((l) => l.kriterium && !kanon.has(l.kriterium.toLowerCase()));\nif (unbekannt.length) return fehler('Der Leitfaden verweist auf ein unbekanntes Kriterium: ' + unbekannt.map((l) => l.kriterium).join(', '));\n\nconst einladenAb = zahl(s.einladenAb) ?? 70;\nconst absageUnter = zahl(s.absageUnter) ?? 45;\nif (absageUnter > einladenAb) return fehler('„Absage unter“ darf nicht über „Einladen ab“ liegen.');\n\nreturn [{ json: {\n  ok: true,\n  assistantId: id,\n  stelle: { assistantId: id, stelle: text(s.stelle), unternehmen: text(s.unternehmen), aufgaben: text(s.aufgaben), anforderungen: text(s.anforderungen), einladenAb, absageUnter },\n  kriterien,\n  leitfaden,\n} }];"
        }
      },
