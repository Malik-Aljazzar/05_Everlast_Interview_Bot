        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Neueste zuerst; das gespeicherte Protokoll-JSON wird für die UI ausgepackt.\nconst lesen = (t) => { try { return t ? JSON.parse(t) : null; } catch (e) { return null; } };\nconst protokolle = $input.all().map((i) => i.json).filter((r) => r.callId).map((r) => ({ ...r, protokoll: lesen(r.protokoll) }));\nreturn [{ json: { protokolle, stand: new Date().toISOString() } }];"
        }
