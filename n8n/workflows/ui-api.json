      {
        "id": "5d746d80-9237-44ad-a5a9-255bc4b7a7d6",
        "name": "Config bauen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          896,
          224
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Je Stelle: Stammdaten, Kriterien und Leitfaden in Reihenfolge (position).\nconst sauber = (r) => { const { id, createdAt, updatedAt, ...rest } = r; return rest; };\nconst alle = (name) => $(name).all().map((i) => i.json).filter((r) => r.assistantId).map(sauber);\nconst nachPosition = (a, b) => (Number(a.position) || 0) - (Number(b.position) || 0);\nconst kriterien = alle('Kriterien lesen');\nconst leitfaden = alle('Leitfaden lesen');\nconst stellen = alle('Stellen lesen').map((s) => ({\n  ...s,\n  kriterien: kriterien.filter((k) => k.assistantId === s.assistantId).sort(nachPosition),\n  leitfaden: leitfaden.filter((l) => l.assistantId === s.assistantId).sort(nachPosition),\n}));\nreturn [{ json: { stellen } }];"
        }
      },
