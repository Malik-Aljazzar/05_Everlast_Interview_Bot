# Let's-Encrypt-Zertifikate für nginx (n8n.mal-zeta.de, everlast.mal-zeta.de) verlängern.
# certbot erneuert erst kurz vor Ablauf; danach lädt nginx das Zertifikat neu.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
17 3,15 * * * root cd /opt/n8n && docker compose run --rm certbot renew --quiet && docker compose exec -T nginx nginx -s reload >/var/log/certbot-renew.log 2>&1
